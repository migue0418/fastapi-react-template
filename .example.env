# Configuración local de Docker Compose.
# Copia este archivo a .env en la raíz del repositorio (el .env no se versiona) y define la contraseña.
#
# Contraseña de PostgreSQL. Obligatoria: mínimo 16 caracteres y distinta de "postgres".
# Conviene que sea alfanumérica y ASCII (los caracteres @ / : # % $ rompen la URL de conexión).
# Genera una con: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
